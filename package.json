{
  "name": "bsdt-internal-desktop",
  "version": "0.4.3",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "electron .",
    "pack": "npm run build && electron-builder --win nsis --x64",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.bsdt.internal",
    "productName": "BSDT内部工作台",
    "directories": {
      "output": "outputs/installers"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build-assets/bsdt.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build-assets/bsdt.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "installerIcon": "build-assets/bsdt.ico",
      "uninstallerIcon": "build-assets/bsdt.ico",
      "installerHeaderIcon": "build-assets/bsdt.ico"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}